  "cards": [
    { "dot": "cyan", "title": "Chat path", "items": [
      "Phone reaches Open WebUI only through private Tailscale Serve; no Funnel or port forwarding",
      "WebUI calls vLLM server-side with the key from .secrets/, so the phone never holds it",
      "One active request; context set at launch (32K script default, 131K from the control app)"
    ] },
    { "dot": "emerald", "title": "Control plane", "items": [
      "Nothing hosts automatically: Qwen, Chat and Sharing start only when requested",
      "Instances run as PTY process groups with bounded transcripts; external ones are observed, not killed",
      "Runtime metadata (port, token) lives in .data/control/server.json"
    ] },
    { "dot": "amber", "title": "Uncommitted phone controls", "items": [
      "control/remote.py + scripts/setup-phone-control.sh are untracked, so not source-linked",
      "Requests via :8443 must carry the owner's Tailscale-User-Login header",
      "Optional pllm-control.service (systemd user + lingering) starts only the controller"
    ] },
    { "dot": "slate", "title": "Not built yet", "items": [
      "Retrieval, memory, web search and code execution are disabled in serve-webui.sh",
      "No coding client, tool runner or backup procedure yet"
    ] }
