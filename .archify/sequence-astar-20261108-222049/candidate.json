  "cards": [
    {
      "dot": "emerald",
      "title": "Local (developer's machine)",
      "items": [
        "Harness runs the tool loop, asks for approval, and shows answers",
        "Writing astar.py is a built-in harness tool on local files",
        "Running tests would also be local, as another model round"
      ]
    },
    {
      "dot": "cyan",
      "title": "Central platform",
      "items": [
        "Gateway: token check, quotas and logging on every model and MCP call",
        "LLM: decides which tool to call and writes the code",
        "Hub + registry: tool discovery and routing to team tool servers (here the search server); registry is consulted at discovery, not per call"
      ]
    },
    {
      "dot": "orange",
      "title": "External",
      "items": [
        "Google is called only by the search server, with its own API key",
        "Harness and model never see the key"
      ]
    },
    {
      "dot": "rose",
      "title": "What leaves the laptop",
      "items": [
        "Prompt, search results and generated code pass through the gateway to the model",
        "Files leave only as model context, never through MCP"
      ]
    }
  ]
