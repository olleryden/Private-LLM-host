  "cards": [
    { "dot": "cyan", "title": "Harness-agnostic", "items": [
      "Harnesses need only two standards: MCP for tools/skills and an LLM API (OpenAI or Anthropic format)",
      "Each harness keeps its own agent loop; swap harnesses without touching tools",
      "Skills served as skill:// resources reach any MCP client, even without native skill support"
    ] },
    { "dot": "emerald", "title": "FastMCP hub", "items": [
      "Mounts team servers and proxies remote ones under namespaces",
      "Builds its tool and skill catalog from the registry; offers search_tools so harnesses load only what they need",
      "Per-tool require_scopes plus AuthMiddleware on top of gateway policy"
    ] },
    { "dot": "violet", "title": "Where Pydantic fits", "items": [
      "Tool input/output models become JSON Schema and are validated on every call",
      "Registry records (ToolSpec, SkillManifest) validated in CI and again at load",
      "pydantic-settings for service configuration"
    ] },
    { "dot": "amber", "title": "Other typical dependencies", "items": [
      "Uvicorn/Starlette (MCP over HTTP), httpx (proxying), SQLAlchemy + asyncpg (registry)",
      "azure-identity for managed identity and on-behalf-of tokens",
      "OpenTelemetry to Azure Monitor for traces of model and tool calls"
    ] },
    { "dot": "rose", "title": "Caveats", "items": [
      "APIM AI Gateway tier is in public preview; Foundry applies gateway routing only to tools created after linking",
      "Skills over MCP is experimental (SEP-2640) and few hosts support it yet"
    ] }
  ]
